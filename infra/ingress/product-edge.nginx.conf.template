  server {
    listen 443 ssl;
    server_name @@PRODUCT_KEYCLOAK_ADMIN_HOST@@;
    ssl_certificate /run/secrets/llmm_edge_tls_certificate;
    ssl_certificate_key /run/secrets/llmm_edge_tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    set $llmm_public_host @@PRODUCT_KEYCLOAK_ADMIN_HOST@@;
    set $llmm_surface keycloak-admin-native;
    include /etc/nginx/llm-machines/request-safety.inc;

    if ($ssl_server_name = "") { return 421; }
    if ($http_host != $ssl_server_name) { return 421; }
    if ($http_cookie ~* "(?:^|;\\s*)__Host-llm-machines-(?:session|login)=") { return 400; }
    if ($llmm_native_product_credential = 1) { return 400; }
    proxy_intercept_errors on;
    error_page 502 503 504 =503 /__llmm_native_unavailable?;

    location = /keycloak/admin/llm-machines/console/whoami {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_keycloak_whoami = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location ^~ /keycloak/admin/llm-machines/console/ {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_keycloak_console = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_intercept_errors on;
      error_page 502 503 504 =503 /__llmm_native_unavailable?;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location = /keycloak/admin/realms/llm-machines {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location = /keycloak/admin/serverinfo {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location = /keycloak/admin/realms/llm-machines/users {
      limit_except GET HEAD POST { deny all; }
      if ($llmm_query_keycloak_users = 0) { return 400; }
      client_max_body_size 64k;
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location ~ "^/keycloak/admin/realms/llm-machines/users/[0-9a-f-]{36}$" {
      if ($request_method = DELETE) { return 403; }
      limit_except GET HEAD PUT { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      client_max_body_size 64k;
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location ~ "^/keycloak/admin/realms/llm-machines/users/[0-9a-f-]{36}/reset-password$" {
      limit_except PUT { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      client_max_body_size 32k;
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location ~ "^/keycloak/admin/realms/llm-machines/users/[0-9a-f-]{36}/sessions$" {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location ~ "^/keycloak/admin/realms/llm-machines/sessions/[A-Za-z0-9_-]{24}$" {
      limit_except DELETE { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location ~ "^/keycloak/admin/realms/llm-machines/groups(?:/[0-9a-f-]{36}(?:/members)?)?$" {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_keycloak_groups = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location ^~ /keycloak/resources/ {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      proxy_pass_request_body off;
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-keycloak-admin-browser.inc;
      proxy_set_header Host $llmm_public_host;
      rewrite ^/keycloak/(.*)$ /$1 break;
      proxy_pass http://keycloak_identity;
    }

    location = /__llmm_native_unavailable {
      internal;
      default_type application/problem+json;
      add_header Cache-Control "no-store" always;
      add_header Retry-After "5" always;
      add_header X-Content-Type-Options "nosniff" always;
      return 503 '{"type":"urn:llm-machines:native-service-unavailable","title":"Identity administration unavailable","status":503}';
    }

    location ~* ^/keycloak/(?:admin/(?:master|realms/(?:master|(?!(?:llm-machines)(?:/|$))[^/]+))|realms/(?:master|(?!(?:llm-machines)(?:/|$))[^/]+))(?:/|$) {
      return 404;
    }

    location / {
      return 404;
    }
  }
}
