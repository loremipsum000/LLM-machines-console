    }

    location = /v2/team/list {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_litellm_team_list = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-litellm-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_pass http://litellm_native;
    }

    location = /team/list {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_litellm_team_list_v1 = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-litellm-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_pass http://litellm_native;
    }

    location ~ ^/(?:api/plugins|organization/list|policies/list|project/list|prompts/list|user/available_roles|user/available_users|v2/guardrails/list|v2/user/info)$ {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-litellm-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_pass http://litellm_native;
    }

    location ~ ^/(?:get/ui_settings|get/ui_theme_settings|get_image|get_favicon|health/license|health/readiness/details|sso/get/ui_settings)$ {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-litellm-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_pass http://litellm_native;
    }

    location ~ ^/(?:model/new|team/new|organization/new|user/new|config/update)$ {
      limit_except POST { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      client_max_body_size 256k;
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-litellm-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_pass http://litellm_native;
    }

    location = /v1/models {
      limit_except GET HEAD { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-litellm-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_pass http://litellm_native;
    }

    location = /v1/chat/completions {
      limit_except POST { deny all; }
      if ($llmm_query_none = 0) { return 400; }
      client_max_body_size 72m;
      include /etc/nginx/llm-machines/proxy-common.inc;
      include /etc/nginx/llm-machines/request-headers-litellm-browser.inc;
      proxy_set_header Host $llmm_public_host;
      proxy_read_timeout 310s;
      proxy_send_timeout 310s;
      proxy_pass http://litellm_native;
    }

    location ~* ^/(?:public/litellm_blog_posts|v1/agents)(?:/|$) {
      return 404;
    }

    location = /__llmm_native_unavailable {
      internal;
      default_type application/problem+json;
      add_header Cache-Control "no-store" always;
