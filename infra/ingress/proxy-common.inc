proxy_http_version 1.1;
proxy_pass_request_headers off;
proxy_request_buffering off;
proxy_buffering off;
proxy_cache off;
proxy_max_temp_file_size 0;
proxy_redirect off;

proxy_set_header Forwarded "";
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Host $llmm_public_host;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Port 443;
proxy_set_header X-Forwarded-Server "";
proxy_set_header X-Forwarded-Prefix "";
proxy_set_header X-Forwarded-Uri "";
proxy_set_header X-Forwarded-Client-Cert "";
proxy_set_header X-Real-IP "";
proxy_set_header X-Original-URL "";
proxy_set_header X-Original-URI "";
proxy_set_header X-Original-Method "";
proxy_set_header X-Rewrite-URL "";
proxy_set_header X-Accel-Redirect "";
proxy_set_header X-Auth-Request-User "";
proxy_set_header X-Auth-Request-Email "";
proxy_set_header X-Auth-Request-Groups "";
proxy_set_header X-Forwarded-User "";
proxy_set_header X-Remote-User "";
proxy_set_header Remote-User "";
proxy_set_header X-HTTP-Method-Override "";
proxy_set_header X-Method-Override "";
proxy_set_header X-Request-ID $request_id;

proxy_set_header Connection "";
proxy_set_header Proxy-Connection "";
proxy_set_header Keep-Alive "";
proxy_set_header Transfer-Encoding "";
proxy_set_header TE "";
proxy_set_header Trailer "";
proxy_set_header Upgrade "";

proxy_set_header X-LLM-Machines-Keycloak-Token "";
proxy_set_header X-LLM-Machines-User-Sub "";
proxy_set_header X-LLM-Machines-User-Email "";
proxy_set_header X-LLM-Machines-User-Roles "";
proxy_set_header X-LLM-Machines-User-Groups "";
proxy_set_header X-LLM-Machines-Recovery-Session-ID "";
proxy_set_header X-LLM-Machines-Request-ID "";
proxy_set_header X-LLM-Machines-Console-Session "";
proxy_set_header X-LLMM-Edge-Authorization "";
proxy_set_header X-LLMM-Expert-System "";
proxy_set_header X-LLMM-Expert-Path "";
proxy_set_header X-LLMM-Expert-Method "";

proxy_hide_header X-Powered-By;
proxy_hide_header Server;
proxy_hide_header X-Accel-Redirect;
add_header Cache-Control "no-store" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
