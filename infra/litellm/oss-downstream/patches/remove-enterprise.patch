diff --git a/.llmm/normalize_oss_build.py b/.llmm/normalize_oss_build.py
new file mode 100644
index 00000000..33c8f1c4
--- /dev/null
+++ b/.llmm/normalize_oss_build.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+
+import base64
+import csv
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+
+site_packages = Path(sys.argv[1]).resolve() / "lib" / "python3.13" / "site-packages"
+
+for cache in sorted(site_packages.rglob("__pycache__"), reverse=True):
+    shutil.rmtree(cache)
+for bytecode in site_packages.rglob("*.pyc"):
+    bytecode.unlink()
+
+for extension in sorted(site_packages.rglob("*.so")):
+    subprocess.run(["strip", "--strip-debug", extension], check=True)
+
+for cache_metadata in site_packages.glob("*.dist-info/uv_cache.json"):
+    cache_metadata.unlink()
+
+for record in sorted(site_packages.glob("*.dist-info/RECORD")):
+    retained = []
+    with record.open(newline="") as source:
+        for relative, _, _ in csv.reader(source):
+            absolute = site_packages / relative
+            if absolute == record:
+                retained.append((relative, "", ""))
+            elif absolute.is_file():
+                content = absolute.read_bytes()
+                digest = base64.urlsafe_b64encode(hashlib.sha256(content).digest()).rstrip(b"=").decode()
+                retained.append((relative, f"sha256={digest}", str(len(content))))
+    temporary = record.with_suffix(".tmp")
+    with temporary.open("w", newline="") as destination:
+        csv.writer(destination, lineterminator="\n").writerows(retained)
+    os.replace(temporary, record)
