{
  "apiVersion": "inference-core.llm-machines/v1",
  "kind": "SGLangEngineContract",
  "metadata": {
    "changePackage": "PR-12-SGLANG-CONTRACT",
    "containsCredentials": false,
    "runtimeQualificationStatus": "NOT_EVALUATED_RUNTIME",
    "sourceOnly": true
  },
  "engine": {
    "name": "sglang",
    "version": "0.5.13",
    "tag": "v0.5.13",
    "tagObject": "cba18f4d8090d23e9273e663db2a0b3b2e39f117",
    "sourceRepository": "https://github.com/sgl-project/sglang.git",
    "sourceCommit": "28b095c01005d4a3a2a5b637b7d028b07fba31b2",
    "sourceArchive": "https://codeload.github.com/sgl-project/sglang/tar.gz/refs/tags/v0.5.13",
    "sourceArchiveSha256": "097aaf0dcc1e8e62c4a107f21d1807734ab76ee40ac4bd7e6e72299b1008ea46",
    "license": {
      "spdx": "Apache-2.0",
      "sha256": "1495e1e757ef4d0925a2350563cf5754bb23c51701a8ec4fb3c5cdcbedae6747"
    },
    "v1Admission": "SOURCE_SELECTED_IMAGE_PROFILE_REQUIRED",
    "excludedEngines": ["vllm"]
  },
  "imageBinding": {
    "owner": "inference-delivery-profile",
    "exactDigestRequired": true,
    "mutableReferenceAllowed": false,
    "historicalLabImageAdmitted": false,
    "hardwareSupportClaimFromSourceSelection": false
  },
  "launch": {
    "baseCommand": ["python3", "-m", "sglang.launch_server"],
    "argumentTemplate": [
      "--model-path",
      "{{model.mountPath}}",
      "--served-model-name",
      "{{model.alias}}",
      "--host",
      "0.0.0.0",
      "--port",
      "{{network.port}}",
      "--context-length",
      "{{limits.configuredContextTokens}}",
      "--tp-size",
      "{{parallelism.tensor}}",
      "--pp-size",
      "{{parallelism.pipeline}}",
      "--dp-size",
      "{{parallelism.data}}",
      "--enable-metrics",
      "--log-level-http",
      "warning",
      "--uvicorn-access-log-exclude-prefixes",
      "/"
    ],
    "requestLoggingEnabled": false,
    "credentialArgumentsAllowed": false,
    "profileAdditionalArgumentsAllowed": true
  },
  "network": {
    "placement": "private-inference-plane",
    "directCustomerReachability": false,
    "allowedCallers": ["litellm-private", "prometheus-private-metrics-only"],
    "publicProductEdgeUpstream": "litellm-private"
  },
  "routes": {
    "openAiCompatible": [
      {
        "method": "GET",
        "path": "/v1/models",
        "allowedCaller": "litellm-private"
      },
      {
        "method": "POST",
        "path": "/v1/chat/completions",
        "allowedCaller": "litellm-private"
      }
    ],
    "liveness": {
      "method": "GET",
      "path": "/health"
    },
    "readiness": {
      "method": "GET",
      "path": "/health_generate"
    },
    "metrics": {
      "method": "GET",
      "path": "/metrics",
      "allowedCaller": "prometheus-private-metrics-only"
    },
    "nativeAdministrationExposed": false
  },
  "modelIdentity": {
    "sourceAndRevisionRequired": true,
    "artifactDigestRequired": true,
    "servedAliasRequired": true,
    "silentSubstitutionAllowed": false,
    "effectiveContextSource": "active-qualified-profile-measurement"
  },
  "retention": {
    "workloadContentRetention": "forbidden",
    "requestLogging": "disabled",
    "responseLogging": "disabled",
    "requestBodyTracing": "disabled",
    "crashContentRetention": "forbidden",
    "modelCacheContainsWorkloadContent": false
  },
  "failureBehavior": {
    "unhealthyRoute": "fail-closed",
    "silentModelFallback": false,
    "hostedFallback": false,
    "litellmProjection": "degraded",
    "applicationCredentialsRemainUnchanged": true,
    "consoleAndAuditContractsRemainUnchanged": true,
    "staleCapacityAdvertisement": "reject"
  },
  "rollback": {
    "requiresPriorProfileRevision": true,
    "requiresExactEngineImageDigest": true,
    "requiresExactModelArtifactDigest": true,
    "automaticSourceMutation": false
  }
}
