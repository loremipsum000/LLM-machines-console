diff --git a/apps/api/src/llm-machines-server.ts b/apps/api/src/llm-machines-server.ts
new file mode 100644
index 0000000..6365d37
--- /dev/null
+++ b/apps/api/src/llm-machines-server.ts
@@ -0,0 +1,107 @@
+import "dotenv/config";
+
+import bodyParser from "body-parser";
+import express, { NextFunction, Request, Response } from "express";
+import { register } from "prom-client";
+import responseTime from "response-time";
+
+import { scrapeController } from "./controllers/v2/scrape";
+import { searchController } from "./controllers/v2/search";
+import type { ErrorResponse } from "./controllers/v2/types";
+import { config } from "./config";
+import { logger } from "./lib/logger";
+import { initializeBlocklist } from "./scraper/WebScraper/utils/blocklist";
+import {
+  authMiddleware,
+  blocklistMiddleware,
+  countryCheck,
+  requestTimingMiddleware,
+  wrap,
+} from "./routes/shared";
+import { RateLimiterMode } from "./types";
+
+const app = express();
+
+app.disable("x-powered-by");
+app.use(bodyParser.json({ limit: "1mb" }));
+app.use(responseTime());
+
+app.get("/v0/health/liveness", (_request, response) => {
+  response.status(200).json({ status: "ok" });
+});
+
+app.get("/v0/health/readiness", (_request, response) => {
+  response.status(200).json({ status: "ok" });
+});
+
+app.get("/metrics", async (_request, response, next) => {
+  try {
+    response.type(register.contentType).send(await register.metrics());
+  } catch (error) {
+    next(error);
+  }
+});
+
+app.use("/v2", requestTimingMiddleware("v2"));
+
+app.post(
+  "/v2/search",
+  authMiddleware(RateLimiterMode.Search, { allowKeyless: true }),
+  countryCheck,
+  blocklistMiddleware,
+  wrap(searchController),
+);
+
+app.post(
+  "/v2/scrape",
+  authMiddleware(RateLimiterMode.Scrape, { allowKeyless: true }),
+  countryCheck,
+  blocklistMiddleware,
+  wrap(scrapeController),
+);
+
+app.use((_request, response) => {
+  response.status(404).json({ success: false, error: "Not found" });
+});
+
+app.use(
+  (
+    error: unknown,
+    _request: Request,
+    response: Response<ErrorResponse>,
+    _next: NextFunction,
+  ) => {
+    logger.error("Firecrawl request failed", {
+      error: error instanceof Error ? error.name : "UnknownError",
+    });
+    response.status(500).json({
+      success: false,
+      code: "UNKNOWN_ERROR",
+      error: "Request failed",
+    });
+  },
+);
+
+initializeBlocklist()
+  .then(() => {
+    const server = app.listen(Number(config.PORT), config.HOST, () => {
+      logger.info("Reduced Firecrawl API ready", {
+        host: config.HOST,
+        port: config.PORT,
+        routes: ["POST /v2/search", "POST /v2/scrape"],
+      });
+    });
+
+    function shutdown() {
+      server.close(() => process.exit(0));
+    }
+
+    process.on("SIGINT", shutdown);
+    process.on("SIGTERM", shutdown);
+  })
+  .catch(error => {
+    logger.error("Reduced Firecrawl initialization failed", {
+      error: error instanceof Error ? error.name : "UnknownError",
+    });
+    process.exit(1);
+  });
