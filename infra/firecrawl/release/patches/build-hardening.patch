diff --git a/apps/playwright-service-ts/Dockerfile b/apps/playwright-service-ts/Dockerfile
index 47217e25685ebd8c8eb0bf83cc325d0c3bd23c33..be9b9fc56a5a9fa09d31e70ab0daffa3e4816729 100644
--- a/apps/playwright-service-ts/Dockerfile
+++ b/apps/playwright-service-ts/Dockerfile
@@ -1,21 +1,57 @@
-FROM node:18-slim
+ARG NODE22_BASE_IMAGE
+ARG PLAYWRIGHT_BROWSER_SOURCE_IMAGE
+ARG WOLFI_RUNTIME_IMAGE
+
+FROM ${NODE22_BASE_IMAGE} AS build
 
 WORKDIR /usr/src/app
-COPY package*.json ./
-RUN npm install
+
+ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
+
+COPY package.json pnpm-lock.yaml ./
+RUN corepack enable \
+    && corepack prepare pnpm@10.34.5 --activate \
+    && pnpm install --frozen-lockfile
 
 COPY . .
 
-ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright
+RUN pnpm run build \
+    && pnpm prune --prod --ignore-scripts
+
+FROM ${PLAYWRIGHT_BROWSER_SOURCE_IMAGE} AS browser
+
+# Fetch byte-locked Wolfi runtime packages.
+FROM browser AS wolfi-playwright-packages
+WORKDIR /wolfi-apks
+
+COPY package-locks/playwright-wolfi.sha256 packages.sha256
+RUN set -eux; \
+    while read -r _package_sha package_file; do \
+      curl --fail --location --silent --show-error \
+        --proto '=https' --tlsv1.2 \
+        --output "${package_file}" \
+        "https://apk.cgr.dev/chainguard/x86_64/${package_file}"; \
+    done < packages.sha256; \
+    sha256sum -c packages.sha256
+
+FROM ${WOLFI_RUNTIME_IMAGE} AS runtime
+
+COPY --from=wolfi-playwright-packages /wolfi-apks/*.apk /wolfi-apks/
+RUN apk add --repositories-file /dev/null --no-network --allow-untrusted /wolfi-apks/*.apk \
+    && rm -rf /wolfi-apks
+
+WORKDIR /usr/src/app
 
-# Install Playwright dependencies
-RUN npx playwright install chromium --with-deps
+ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
+    HOME=/home/nonroot \
+    PORT=3000
 
-RUN npm run build
+COPY --from=build --chown=65532:65532 /usr/src/app/node_modules ./node_modules
+COPY --from=build --chown=65532:65532 /usr/src/app/dist ./dist
+COPY --from=browser /ms-playwright/chromium_headless_shell-1234 /ms-playwright/chromium_headless_shell-1234
 
-ARG PORT
-ENV PORT=${PORT}
+USER 65532:65532
 
-EXPOSE ${PORT}
+EXPOSE 3000
 
-CMD [ "npm", "start" ]
+CMD ["/usr/bin/node", "dist/api.js"]
