+# Koffi 2.9.0 ships its linux/x64 native module with an executable GNU_STACK.
+# Clear only that ELF program-header flag before the hardened runtime copies it.
+RUN node - <<'NODE'
+const fs = require("node:fs");
+const path = require("node:path");
+
+const modulePath = path.join(
+  path.dirname(require.resolve("koffi")),
+  "build/koffi/linux_x64/koffi.node",
+);
+const elf = fs.readFileSync(modulePath);
+if (elf.readUInt32LE(0) !== 0x464c457f || elf[4] !== 2 || elf[5] !== 1) {
+  throw new Error("Koffi is not a 64-bit little-endian ELF module");
+}
+const programHeaderOffset = Number(elf.readBigUInt64LE(32));
+const programHeaderSize = elf.readUInt16LE(54);
+const programHeaderCount = elf.readUInt16LE(56);
+let stackHeaderFound = false;
+for (let index = 0; index < programHeaderCount; index += 1) {
+  const offset = programHeaderOffset + index * programHeaderSize;
+  if (elf.readUInt32LE(offset) !== 0x6474e551) continue;
+  const flags = elf.readUInt32LE(offset + 4);
+  if ((flags & 1) !== 1) {
+    throw new Error("Koffi GNU_STACK was already non-executable");
+  }
+  elf.writeUInt32LE(flags & ~1, offset + 4);
+  stackHeaderFound = true;
