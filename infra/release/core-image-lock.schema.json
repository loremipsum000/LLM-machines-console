{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-machines.invalid/schemas/core-image-lock.v1.json",
  "title": "LLM Machines immutable Core image lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "release",
    "inventorySha256",
    "platform",
    "privateRegistry",
    "images"
  ],
  "properties": {
    "schema": { "const": "llm-machines.core-image-lock.v1" },
    "status": { "const": "LOCKED" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceCommit", "sourceTree"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceCommit": { "$ref": "#/$defs/sha1" },
        "sourceTree": { "$ref": "#/$defs/sha1" }
      }
    },
    "inventorySha256": { "$ref": "#/$defs/sha256" },
    "platform": { "const": "linux/amd64" },
    "privateRegistry": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+(?::[0-9]{1,5})?$"
    },
    "images": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "version",
        "indexDigest",
        "platform",
        "platformDigest",
        "sourceRevision",
        "license",
        "sbomSha256",
        "provenanceSha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "repository": { "type": "string", "minLength": 3 },
        "version": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^|[-_.])(latest|LATEST)($|[-_.])" }
        },
        "indexDigest": { "$ref": "#/$defs/sha256" },
        "platform": { "const": "linux/amd64" },
        "platformDigest": { "$ref": "#/$defs/sha256" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sbomSha256": { "$ref": "#/$defs/sha256" },
        "provenanceSha256": { "$ref": "#/$defs/sha256" },
        "correspondingSourceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
