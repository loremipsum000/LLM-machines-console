{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-machines.invalid/schemas/core-image-lock.v2.json",
  "title": "LLM Machines immutable Core image lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "release",
    "inventorySha256",
    "platform",
    "images"
  ],
  "properties": {
    "schema": { "const": "llm-machines.core-image-lock.v2" },
    "status": { "const": "LOCKED" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceCommit", "sourceTree"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceCommit": { "$ref": "#/$defs/sha1" },
        "sourceTree": { "$ref": "#/$defs/sha1" }
      }
    },
    "inventorySha256": { "$ref": "#/$defs/sha256" },
    "platform": { "const": "linux/amd64" },
    "images": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mirrorRepository",
        "version",
        "ociArchivePath",
        "ociArchiveSha256",
        "approvedSourceIndexDigest",
        "approvedSourcePlatformDigest",
        "indexDigest",
        "platform",
        "platformDigest",
        "sourceRevision",
        "license",
        "sbomSha256",
        "provenanceSha256",
        "vulnerabilityReportSha256",
        "vulnerabilityDispositionSha256",
        "licenseTextSha256",
        "noticeSha256",
        "licenseReviewSha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "mirrorRepository": {
          "type": "string",
          "pattern": "^core/[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^|[-_.])(latest|LATEST)($|[-_.])" }
        },
        "ociArchivePath": {
          "type": "string",
          "pattern": "^images/[a-z0-9][a-z0-9-]*\\.oci\\.tar\\.zst$"
        },
        "ociArchiveSha256": { "$ref": "#/$defs/sha256" },
        "approvedSourceIndexDigest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "approvedSourcePlatformDigest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "indexDigest": { "$ref": "#/$defs/sha256" },
        "platform": { "const": "linux/amd64" },
        "platformDigest": { "$ref": "#/$defs/sha256" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sbomSha256": { "$ref": "#/$defs/sha256" },
        "provenanceSha256": { "$ref": "#/$defs/sha256" },
        "vulnerabilityReportSha256": { "$ref": "#/$defs/sha256" },
        "vulnerabilityDispositionSha256": { "$ref": "#/$defs/sha256" },
        "licenseTextSha256": { "$ref": "#/$defs/sha256" },
        "noticeSha256": { "$ref": "#/$defs/sha256" },
        "licenseReviewSha256": { "$ref": "#/$defs/sha256" },
        "correspondingSourceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
