{
  "name": "@llm-machines/agentic-adapter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "corepack pnpm --filter @llm-machines/contracts build && tsc --project tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "corepack pnpm --filter @llm-machines/contracts build && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@llm-machines/contracts": "workspace:*",
    "fastify": "4.29.1"
  },
  "devDependencies": {
    "@types/node": "22.15.18",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "llmMachines": {
    "tier": "t1"
  }
}
