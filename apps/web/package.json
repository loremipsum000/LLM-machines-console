  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm --filter @llm-machines/contracts build && corepack pnpm --filter @llm-machines/copy build && next build",
    "dev": "next dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "corepack pnpm --filter @llm-machines/contracts build && corepack pnpm --filter @llm-machines/copy build && vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@llm-machines/contracts": "workspace:*",
    "@llm-machines/copy": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "15.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "16.3.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "22.15.18",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "jest-axe": "10.0.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "llmMachines": {
