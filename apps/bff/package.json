{
  "name": "@llm-machines/bff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit:ingest": "tsx src/commands/audit-ingestion.ts",
    "build": "corepack pnpm --filter @llm-machines/contracts build && tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "retention:prune": "tsx src/commands/inference-core-retention.ts",
    "test": "corepack pnpm --filter @llm-machines/contracts build && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@llm-machines/contracts": "workspace:*",
    "drizzle-orm": "0.44.2",
    "fastify": "4.29.1",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "22.15.18",
    "drizzle-kit": "0.31.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  },
  "llmMachines": {
    "tier": "t1"
  }
}
