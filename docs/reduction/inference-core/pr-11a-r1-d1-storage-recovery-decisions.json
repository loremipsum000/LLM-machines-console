  "sourceAcceptanceCriteria": [
    "the five required ZFS dataset roles and distinct mount boundaries are exact and local snapshots never count as backups",
    "restic is the only v1 backup engine and uses a separate customer-owned mounted target with encrypted versioned snapshots, daily cadence, and 30-day retention",
    "repository locator and password are accepted only through root-only mounted files and never as inline values or environment-variable secrets",
    "backup inputs are an explicit safe-state allowlist and models, transient data, plaintext credentials, private signing keys, and recovery envelopes remain excluded",
    "deterministic canaries prove workload content cannot enter the restic manifest, transient surfaces, backup logs, or restored tree",
    "a clean restore remains a Q0 release gate and no runtime storage, backup, object store, real target, secret, or aggregate PR-11A revision is created"
  ],
  "explicitlyDisabledAfterPackage": [
    "live-zfs-provisioning",
