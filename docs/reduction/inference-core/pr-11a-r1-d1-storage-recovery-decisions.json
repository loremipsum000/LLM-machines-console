  "bindingDecisions": {
    "localStorage": {
      "backend": "zfs",
      "productRequirement": "required",
      "separateDatasetRoles": [
        "product_state",
        "databases",
        "models",
        "logs",
        "staging"
      ],
      "localSnapshotsCountAsBackups": false
    },
    "backup": {
      "engine": "restic",
      "target": "separate-customer-owned-mounted-filesystem",
      "encrypted": true,
      "versioned": true,
      "defaultCadence": "daily",
      "retentionDays": 30,
      "repositoryLocatorProvisioning": "root-only-mounted-file",
      "repositoryPasswordProvisioning": "root-only-mounted-file",
      "inlineOrEnvironmentSecretsAllowed": false,
      "cleanRestoreRequired": true
    },
    "backupAllowlist": [
      "product-configuration",
      "identity-mappings",
      "credential-verifier-state-and-safe-metadata",
      "keycloak-configuration-export",
      "litellm-configuration-export",
      "grafana-configuration-export",
      "audit-records",
      "entitlement-state",
      "update-state"
    ],
    "backupExclusions": [
      "models-pending-model-recovery-decision",
      "logs",
      "staging",
      "caches",
      "temporary-files",
      "crash-artifacts",
      "one-time-plaintext-credentials",
      "all-private-signing-keys",
      "audit-recovery-envelope"
    ],
    "zeroContentCanarySurfaces": [
      "restic-input-manifest",
      "cache",
      "temporary-files",
      "staging",
      "backup-logs",
      "restored-tree"
    ],
    "objectStorage": {
      "genericS3ServiceInBom": false,
      "minioInBom": false,
      "seaweedFsInBom": false,
      "unusedAdapterAllowed": false,
      "futureCallerInterface": "s3-compatible-after-proven-need"
    }
  },
