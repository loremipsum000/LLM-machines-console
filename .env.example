# Product metadata
PRODUCT_CONSOLE_HOST=console.example.test
PRODUCT_API_HOST=api.example.test
PRODUCT_IDENTITY_HOST=identity.example.test
PRODUCT_FIRECRAWL_HOST=firecrawl.example.test
# Retained native administration authorities. These are credential-free
# commissioning inputs shared by the Product edge and Console Technical Tools.
PRODUCT_GRAFANA_HOST=grafana.example.test
PRODUCT_LITELLM_HOST=litellm.example.test
PRODUCT_KEYCLOAK_ADMIN_HOST=keycloak.example.test
POSTGRES_USER=console
POSTGRES_PASSWORD=
POSTGRES_DB=console
POSTGRES_PORT=54320
DATABASE_URL=

# Console Web server-to-BFF session forwarding. The browser receives only an
# opaque secure cookie; tokens remain in the BFF encrypted session store.
CONSOLE_BFF_URL=http://console-bff:4001
CONSOLE_BFF_SERVICE_API_KEY=

# BFF Console identity, session custody, and appliance-realm administration
HOST=0.0.0.0
PORT=4001
CONSOLE_ORIGIN=https://console.example.test
KEYCLOAK_ISSUER_URL=https://identity.example.test/realms/llm-machines
KEYCLOAK_AUDIENCE=console-bff
CONSOLE_OIDC_CLIENT_ID=console-web
CONSOLE_OIDC_CLIENT_SECRET=
CONSOLE_OIDC_ELEVATION_ACR_VALUES=urn:llm-machines:mfa
CONSOLE_SESSION_KEYRING_FILE=/run/secrets/llmm_console_session_keyring
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=llm-machines
KEYCLOAK_ADMIN_CLIENT_ID=console-human-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_APPLICATION_ADMIN_REALM=llm-machines-applications
KEYCLOAK_APPLICATION_ADMIN_CLIENT_ID=console-application-admin
KEYCLOAK_APPLICATION_ADMIN_CLIENT_SECRET=
KEYCLOAK_APPLICATION_ISSUER_URL=https://identity.example.test/realms/llm-machines-applications
TEAM_ALLOWED_EMAIL_DOMAINS=example.test
TEAM_SCIM_PROVIDER=
TEAM_SCIM_LAST_SYNC_AT=
BFF_SERVICE_API_KEY=
BFF_FIXTURE_MODE=false

# LiteLLM data plane for inference and the connected-application gateway
LITELLM_URL=http://litellm:4000
LITELLM_KEY=

# LiteLLM Admin API read projection. Use a separate admin credential; the BFF
# does not fall back to LITELLM_KEY when these values are absent.
ADMIN_LITELLM_BASE_URL=http://litellm:4000
ADMIN_LITELLM_API_KEY=
ADMIN_LITELLM_TIMEOUT_MS=2500
BFF_FALLBACK_MODELS=
PUBLIC_BFF_BASE_URL=https://api.example.test
CONNECTED_APPS_BFF_BASE_URL=https://api.example.test
CONNECTED_APPS_TOKEN_URL=https://identity.example.test/realms/llm-machines-applications/protocol/openid-connect/token
CONNECTED_APPS_KEYCLOAK_FIXTURE=false

# Observability and retained appliance services
ADMIN_PROMETHEUS_BASE_URL=http://prometheus:9090
ADMIN_PROMETHEUS_TIMEOUT_MS=2000
ADMIN_PROMETHEUS_MAX_RESPONSE_BYTES=1048576
ADMIN_PROMETHEUS_BEARER_TOKEN_FILE=/run/secrets/llmm_prometheus_query_bearer
ADMIN_GRAFANA_BASE_URL=http://grafana:3000
ADMIN_ALERTMANAGER_BASE_URL=http://alertmanager:9093
ADMIN_ALERTMANAGER_TIMEOUT_MS=2000
ADMIN_ALERTMANAGER_MAX_RESPONSE_BYTES=524288
ADMIN_ALERTMANAGER_BEARER_TOKEN_FILE=/run/secrets/llmm_alertmanager_bearer
BFF_OBSERVABILITY_METRICS_TOKEN_FILE=/run/secrets/llmm_prometheus_scrape_bearer
# Native Grafana and Alertmanager links are not customer surfaces in v1.
ADMIN_SETTINGS_REACHABILITY_TIMEOUT_MS=2500
LIFECYCLE_SERVICE_BASE_URL=

# Signed Activity export uses a customer-owned, per-appliance Ed25519 key.
# The private key is mounted read-only for root; public rotation keys remain in
# the trust bundle.
AUDIT_EXPORT_SIGNING_ACTIVE_KID=
AUDIT_EXPORT_SIGNING_APPLIANCE_ID=
AUDIT_EXPORT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/llmm_audit_export_ed25519
AUDIT_EXPORT_SIGNING_TRUST_BUNDLE_FILE=/run/llm-machines/signing-trust.json

# Firecrawl appliance installation and readiness. These values never grant
# per-Application access; that policy is stored in the product database.
FIRECRAWL_INSTALLED=true
FIRECRAWL_APPLIANCE_KILL_SWITCH=true
FIRECRAWL_RESOURCE_PROFILE_QUALIFIED=false
FIRECRAWL_EGRESS_POLICY_READY=false
# Public clients use the governed BFF origin; native Firecrawl stays private.
FIRECRAWL_PUBLIC_BASE_URL=https://firecrawl.example.test
FIRECRAWL_UPSTREAM_BASE_URL=http://firecrawl-api:3002
FIRECRAWL_EGRESS_ALLOWED_HOSTS=example.test
FIRECRAWL_EGRESS_ALLOWLIST_DIR=/run/llm-machines/firecrawl/egress-allowlist
