# Product metadata
POSTGRES_USER=console
POSTGRES_PASSWORD=
POSTGRES_DB=console
POSTGRES_PORT=54320
DATABASE_URL=

# Console Web authentication
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=console-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://keycloak.example.test/realms/llm-machines
CONSOLE_BFF_URL=http://localhost:4001
CONSOLE_BFF_SERVICE_API_KEY=

# BFF authentication and appliance-realm administration
HOST=0.0.0.0
PORT=4001
KEYCLOAK_ISSUER_URL=https://keycloak.example.test/realms/llm-machines
KEYCLOAK_AUDIENCE=console-bff
KEYCLOAK_ADMIN_BASE_URL=https://keycloak.example.test
KEYCLOAK_ADMIN_REALM=llm-machines
KEYCLOAK_ADMIN_CLIENT_ID=console-human-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_APPLICATION_ADMIN_REALM=llm-machines-applications
KEYCLOAK_APPLICATION_ADMIN_CLIENT_ID=console-application-admin
KEYCLOAK_APPLICATION_ADMIN_CLIENT_SECRET=
KEYCLOAK_APPLICATION_ISSUER_URL=https://keycloak.example.test/realms/llm-machines-applications
TEAM_ALLOWED_EMAIL_DOMAINS=example.test
TEAM_SCIM_PROVIDER=
TEAM_SCIM_LAST_SYNC_AT=
BFF_SERVICE_API_KEY=
BFF_FORWARDED_ACCESS_TOKEN_HEADER=x-llm-machines-keycloak-token
BFF_FORWARDED_USER_HEADER=x-llm-machines-user-sub
BFF_FORWARDED_EMAIL_HEADER=x-llm-machines-user-email
BFF_FORWARDED_ROLES_HEADER=x-llm-machines-user-roles
BFF_FORWARDED_GROUPS_HEADER=x-llm-machines-user-groups
BFF_FIXTURE_MODE=false

# LiteLLM data plane for inference and the connected-application gateway
LITELLM_URL=http://localhost:4000
LITELLM_KEY=
LITELLM_PUBLIC_URL=https://litellm.example.test

# LiteLLM Admin API read projection. Use a separate admin credential; the BFF
# does not fall back to LITELLM_KEY when these values are absent.
ADMIN_LITELLM_BASE_URL=http://localhost:4000
ADMIN_LITELLM_API_KEY=
ADMIN_LITELLM_TIMEOUT_MS=2500
BFF_FALLBACK_MODELS=
PUBLIC_BFF_BASE_URL=http://localhost:4001
CONNECTED_APPS_BFF_BASE_URL=http://localhost:4001
CONNECTED_APPS_TOKEN_URL=https://keycloak.example.test/realms/llm-machines-applications/protocol/openid-connect/token
CONNECTED_APPS_KEYCLOAK_FIXTURE=false

# Observability and retained appliance services
ADMIN_PROMETHEUS_BASE_URL=http://localhost:9090
ADMIN_PROMETHEUS_TIMEOUT_MS=2000
ADMIN_GRAFANA_BASE_URL=http://localhost:3002
ADMIN_ALERTMANAGER_BASE_URL=http://localhost:9093
ADMIN_SETTINGS_REACHABILITY_TIMEOUT_MS=2500
LIFECYCLE_SERVICE_BASE_URL=

# Firecrawl appliance installation and readiness. These values never grant
# per-Application access; that policy is stored in the product database.
FIRECRAWL_INSTALLED=true
FIRECRAWL_APPLIANCE_KILL_SWITCH=true
FIRECRAWL_RESOURCE_PROFILE_QUALIFIED=false
FIRECRAWL_EGRESS_POLICY_READY=false
# Public clients use the governed BFF origin; native Firecrawl stays private.
FIRECRAWL_PUBLIC_BASE_URL=https://bff.example.test
FIRECRAWL_UPSTREAM_BASE_URL=http://firecrawl-api:3002
FIRECRAWL_EGRESS_ALLOWED_HOSTS=example.test
FIRECRAWL_EGRESS_ALLOWLIST_DIR=/run/llm-machines/firecrawl/egress-allowlist

# Signed model-update metadata
INFERENCE_MODEL_UPDATE_STATUS=not_configured
INFERENCE_MODEL_UPDATE_CURRENT_VERSION=
INFERENCE_MODEL_UPDATE_AVAILABLE_VERSION=
INFERENCE_MODEL_UPDATE_DETAIL=
INFERENCE_MODEL_UPDATE_ESTIMATED_DOWNTIME=
INFERENCE_MODEL_UPDATE_RELEASE_NOTES=
INFERENCE_MODEL_UPDATE_AFFECTED_MODELS=
INFERENCE_MODEL_UPDATE_ACTION_ENABLED=false
INFERENCE_MODEL_UPDATE_APPLY_RESULT=
