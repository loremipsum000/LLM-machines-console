COMPOSE_PROJECT_NAME=llm-machines-console

POSTGRES_USER=console
POSTGRES_PASSWORD=
POSTGRES_DB=console
POSTGRES_PORT=54320
DATABASE_URL=

REDIS_PORT=63790
REDIS_URL=redis://localhost:63790

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
KNOWLEDGE_MINIO_BUCKET=console-knowledge

SIDECAR_PORT=8000
KNOWLEDGE_SIDECAR_URL=http://localhost:8000
KNOWLEDGE_SIDECAR_SERVICE_TOKEN=
KNOWLEDGE_SIDECAR_TIMEOUT_MS=10000
KNOWLEDGE_SIDECAR_MAX_RESPONSE_BYTES=16777216
KNOWLEDGE_SIDECAR_MAX_REQUEST_BYTES=75497472

PDF_PARSER_PORT=8002
KNOWLEDGE_PDF_PARSER_URL=http://localhost:8002
KNOWLEDGE_PDF_PARSER_SERVICE_TOKEN=
KNOWLEDGE_PDF_PARSER_TIMEOUT_MS=30000
KNOWLEDGE_PDF_PARSER_MAX_RESPONSE_BYTES=8388608
KNOWLEDGE_PDF_MAX_FILE_BYTES=52428800
KNOWLEDGE_PDF_MAX_PAGES=250
KNOWLEDGE_URL_FETCH_TIMEOUT_MS=10000
KNOWLEDGE_URL_FETCH_MAX_BYTES=5242880
KNOWLEDGE_FIRECRAWL_ENABLED=false
KNOWLEDGE_FIRECRAWL_API_URL=
KNOWLEDGE_FIRECRAWL_API_KEY=
KNOWLEDGE_FIRECRAWL_VERSION=v1
KNOWLEDGE_URL_WORKER_POLL_INTERVAL_MS=5000
KNOWLEDGE_URL_WORKER_BATCH_SIZE=5
KNOWLEDGE_VECTOR_RETRIEVAL=true
KNOWLEDGE_SEARCH_MODE=hybrid
KNOWLEDGE_EMBEDDING_MODEL=knowledge-embedding-local
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=llm-machines
KEYCLOAK_HOSTNAME=https://keycloak.example.test/keycloak
LIBRECHAT_PUBLIC_ORIGIN=https://librechat.example.test
KEYCLOAK_DB_PASSWORD=
LIBRECHAT_OPENID_CLIENT_SECRET=
LIBRECHAT_OPENID_SESSION_SECRET=
LITELLM_PUBLIC_ORIGIN=https://litellm.example.test
LITELLM_OPENID_CLIENT_SECRET=
PORTAINER_PUBLIC_ORIGIN=https://portainer.example.test
PORTAINER_OPENID_CLIENT_SECRET=
GRAFANA_PUBLIC_ORIGIN=https://grafana.example.test
GRAFANA_OPENID_CLIENT_SECRET=
CONSOLE_WEB_PUBLIC_ORIGIN=http://localhost:3000
LAB_CONSOLE_WEB_PUBLIC_ORIGIN=https://console.example.test
CONSOLE_WEB_OPENID_CLIENT_SECRET=
DEMO_ADMIN_PASSWORD=
DEMO_BUILDER_PASSWORD=
DEMO_CONSUMER_PASSWORD=

BFF_PORT=4001
WEB_PORT=3000
# Local Hub/Builder fixture mode only. Production Console routes fail closed
# without CONSOLE_BFF_URL and CONSOLE_BFF_SERVICE_API_KEY.
CONSOLE_WEB_FIXTURE_MODE=false
WEB_SERVER_ACTION_BODY_SIZE_LIMIT=75mb
BFF_BODY_LIMIT_BYTES=75497472

# BFF -> Keycloak / LibreChat / LiteLLM
KEYCLOAK_ISSUER_URL=https://keycloak.example.test/keycloak/realms/llm-machines
KEYCLOAK_AUDIENCE=console-bff
KEYCLOAK_ADMIN_BASE_URL=https://keycloak.example.test/keycloak
KEYCLOAK_ADMIN_REALM=llm-machines
KEYCLOAK_ADMIN_CLIENT_ID=console-team-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
TEAM_ALLOWED_EMAIL_DOMAINS=example.test
AUTH_SECRET=
AUTH_KEYCLOAK_ID=console-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://keycloak.example.test/keycloak/realms/llm-machines
LIBRECHAT_PUBLIC_URL=https://librechat.example.test
GRAFANA_EMBED_URL=
GRAFANA_PUBLIC_URL=https://grafana.example.test
KEYCLOAK_ADMIN_EMBED_URL=
KEYCLOAK_ADMIN_PUBLIC_URL=https://keycloak.example.test/keycloak/admin/master/console/#/llm-machines
KEYCLOAK_PUBLIC_URL=https://keycloak.example.test/keycloak
LITELLM_EMBED_URL=
LITELLM_PUBLIC_URL=https://litellm.example.test
BFF_SERVICE_API_KEY=
BFF_FORWARDED_ACCESS_TOKEN_HEADER=x-llm-machines-keycloak-token
BFF_FORWARDED_USER_HEADER=x-llm-machines-user-sub
BFF_FORWARDED_EMAIL_HEADER=x-llm-machines-user-email
BFF_FORWARDED_ROLES_HEADER=x-llm-machines-user-roles
BFF_MCP_ALLOW_SERVICE_FORWARDED_AUTH=true
BFF_FIXTURE_MODE=false
BFF_FALLBACK_MODELS=qwen3-35b-local,gemma4
MCP_CATALOG_BUNDLE_PATH=
MCP_CATALOG_PUBLIC_KEY_PEM=
MCP_CATALOG_ALLOW_SEED=false
BUILDER_AGENT_STUDIO_DAILY_RUN_LIMIT=
BUILDER_AGENT_STUDIO_DAILY_TOKEN_LIMIT=
LITELLM_URL=http://localhost:4000
LITELLM_KEY=
ADMIN_LITELLM_BASE_URL=
ADMIN_LITELLM_API_KEY=
ADMIN_LITELLM_TIMEOUT_MS=2500
ADMIN_PROMETHEUS_BASE_URL=
ADMIN_PROMETHEUS_TIMEOUT_MS=2000

# BFF -> agentic runtime. Leave unset unless the runtime is reachable through an
# authenticated/internal route; do not expose raw sandbox ports directly to users.
AGENTIC_OPENCLAW_BASE_URL=
AGENTIC_OPENCLAW_CHAT_COMPLETIONS_PATH=/v1/chat/completions
AGENTIC_OPENCLAW_TOKEN=
AGENTIC_OPENCLAW_MODEL=
AGENTIC_HERMES_BASE_URL=
AGENTIC_RUNTIME_TIMEOUT_MS=30000

# BFF -> agentic adapter. The adapter runs on the agentic VM and applies
# OpenShell policy changes locally.
AGENTIC_ADAPTER_BASE_URL=
AGENTIC_ADAPTER_TOKEN=
AGENTIC_APPROVAL_SIGNING_SECRET=
AGENTIC_RUNTIME_CONTROL_ADMIN_SUBJECTS=

# Agentic adapter local settings belong in an adapter-specific env file because
# the adapter process reads HOST/PORT directly.
# AGENTIC_ADAPTER_APPLY=false
